# Copy to .env.local (local) and add the same keys in Vercel → Settings → Environment Variables.
# Never commit real keys. .env*.local is git-ignored.

# Public site URL — canonical/SEO and Stripe success/cancel redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---------- Stripe ----------
# Server-only secret key: sk_test_... for testing, sk_live_... for real payments.
# Live keys are refused until PRICING_CONFIRMED = true in lib/products.ts.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<domain>/api/stripe/webhook (whsec_...).
# Test and live mode each have their own endpoint and secret.
STRIPE_WEBHOOK_SECRET=
# Optional: a Shipping Rate id (shr_...) from Stripe → Product catalog → Shipping rates.
# When set, the rate is charged on Stripe's checkout page; otherwise shipping shows "To be confirmed".
STRIPE_SHIPPING_RATE_ID=
# Not used by the hosted Checkout redirect. Only needed if Stripe Elements is added later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Notifications ----------
# Contact form, offer claims and paid-order alerts are POSTed here as JSON (Formspree, Zapier, Make, own API).
CONTACT_WEBHOOK_URL=

# Donation / offer checkout link once the TheUrbanSurvivor.org workflow is confirmed.
NEXT_PUBLIC_OFFER_URL=
