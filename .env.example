# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.com

# Stripe — server secret stays server-side. Without it, checkout shows "payments not connected".
STRIPE_SECRET_KEY=
# Only needed if you later add Stripe Elements on the client; Checkout redirect does not use it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Where contact-form and offer-claim submissions are POSTed as JSON (Formspree, Zapier, Make, own API).
CONTACT_WEBHOOK_URL=

# Donation / offer checkout link once the TheUrbanSurvivor.org workflow is confirmed.
NEXT_PUBLIC_OFFER_URL=
